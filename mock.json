      { "time": "10:00", "ac": "climate.living_room_ac", "temp": 10, "mode": "off", "fan": "low", "led": true },
      { "time": "18:00", "ac": "all", "temp": 21, "mode": "heat", "fan": "auto", "led": false },
      { "time": "23:00", "ac": "all", "temp": 14, "mode": "heat", "fan": "quiet", "led": false }
    ]
  }
